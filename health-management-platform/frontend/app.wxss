/* 全局样式 */
page {
  background-color: #f8f8f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
}

/* 容器 */
.container {
  padding: 20rpx;
}

/* 卡片样式 */
.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 按钮样式 */
.btn {
  background-color: #1aad19;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn:hover {
  background-color: #179b16;
}

.btn-secondary {
  background-color: #f8f8f8;
  color: #333;
  border: 2rpx solid #ddd;
}

.btn-outline {
  background-color: transparent;
  color: #1aad19;
  border: 2rpx solid #1aad19;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 28rpx;
}

.btn-large {
  padding: 28rpx 56rpx;
  font-size: 36rpx;
}

/* 输入框样式 */
.input {
  background-color: #f8f8f8;
  border: 2rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.input:focus {
  border-color: #1aad19;
}

/* 表单组 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #666;
}

/* 文本样式 */
.text-primary {
  color: #1aad19;
}

.text-secondary {
  color: #666;
}

.text-muted {
  color: #999;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-large {
  font-size: 36rpx;
}

.text-small {
  font-size: 24rpx;
}

.text-bold {
  font-weight: bold;
}

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }
.p-10 { padding: 10rpx; }
.p-20 { padding: 20rpx; }

/* 布局 */
.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
  align-items: center;
}

.flex-around {
  justify-content: space-around;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 图标 */
.icon {
  width: 40rpx;
  height: 40rpx;
}

.icon-large {
  width: 60rpx;
  height: 60rpx;
}

.icon-small {
  width: 24rpx;
  height: 24rpx;
}

/* 列表 */
.list-item {
  background-color: white;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  display: flex;
  align-items: center;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.list-item-desc {
  font-size: 28rpx;
  color: #666;
}

.list-item-value {
  font-size: 32rpx;
  color: #1aad19;
  font-weight: bold;
}

/* 徽章 */
.badge {
  display: inline-block;
  padding: 6rpx 12rpx;
  font-size: 24rpx;
  border-radius: 20rpx;
  background-color: #f0f0f0;
  color: #666;
}

.badge-primary {
  background-color: #1aad19;
  color: white;
}

.badge-warning {
  background-color: #ff9500;
  color: white;
}

.badge-danger {
  background-color: #ff3333;
  color: white;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background-color: #f0f0f0;
  margin: 20rpx 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 20rpx;
  color: #999;
}

.empty-state-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  opacity: 0.3;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

/* 图表容器 */
.chart-container {
  height: 400rpx;
  margin: 20rpx 0;
}