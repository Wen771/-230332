<view class="container">
  <view class="login-container">
    <view class="logo-section">
      <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
      <text class="app-title">健康管理平台</text>
      <text class="app-desc">记录健康，管理生活</text>
    </view>

    <view class="login-section">
      <button 
        class="login-btn"
        open-type="getUserInfo"
        bindgetuserinfo="getUserInfo"
        wx:if="{{!userInfo}}"
      >
        <image class="wechat-icon" src="/images/wechat.png"></image>
        微信快速登录
      </button>

      <button 
        class="login-btn"
        bindtap="doLogin"
        wx:if="{{userInfo}}"
      >
        <image class="wechat-icon" src="/images/wechat.png"></image>
        确认登录
      </button>
    </view>

    <view class="tips">
      <text class="tip-text">登录即表示同意《用户协议》和《隐私政策》</text>
    </view>
  </view>
</view>